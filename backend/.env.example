DATABASE_URL=sqlite:///./indu_twin.db
CORS_ORIGINS=http://localhost:5173
SIMULATION_INTERVAL_SECONDS=15

# Ingesta de ESP32 reales via MQTT (desactivado hasta tener hardware/broker)
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Autenticacion: cambia el secreto en produccion
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Email de alertas criticas (opcional). Si SMTP_HOST se deja vacio, no se
# manda ningun correo: la app sigue funcionando igual, solo sin avisos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:5173

# Plan comercial de esta instancia: free (1 poligono / 3 naves / 2 usuarios),
# pro (3 / 15 / 10) o business (sin limite).
PLAN=free
